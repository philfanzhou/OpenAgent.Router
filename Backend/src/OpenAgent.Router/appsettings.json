{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.OpenTelemetry" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Grpc": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "OpenTelemetry",
        "Args": {
          "protocol": "HttpProtobuf",
          "resourceAttributes": {
            "service.name": "agent-router",
            "service.version": "1.0.0",
            "app": "open-agent",
            "env": "prod"
          }
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Authority": "https://cd-agent-matrix01.monolithicpower.com:8443",
    "Audience": "agent-api"
  },
  "RouterSettings": {
    "RateLimiting": {
      "RequestsPerSecond": 100,
      "BurstCapacity": 200
    },
    "IntentRecognition": {
      "TimeoutMs": 200
    }
  }
}
