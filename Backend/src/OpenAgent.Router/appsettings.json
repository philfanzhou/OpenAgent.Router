{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.OpenTelemetry" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Grpc": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "OpenTelemetry",
        "Args": {
          "protocol": "HttpProtobuf",
          "resourceAttributes": {
            "service.name": "agent-router",
            "service.version": "1.0.0",
            "app": "open-agent",
            "env": "prod"
          }
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Authentication": {
    "Mode": "Basic",
    "AllowTenantHeader": true,
    "AllowDevelopmentAnonymous": false,
    "DevelopmentUserId": "development-user",
    "DevelopmentTenantId": "development"
  },
  "RouterSettings": {
    "RateLimiting": {
      "RequestsPerSecond": 100,
      "BurstCapacity": 200
    },
    "IntentRecognition": {
      "Enabled": true,
      "ProviderId": "self-engine",
      "AgentId": "intent-router",
      "FallbackAgentId": "default",
      "MinimumConfidence": 0.5,
      "TimeoutMs": 5000
    },
    "AgentProviders": {
      "DefaultProviderId": "self-engine",
      "Providers": [
        {
          "Id": "self-engine",
          "Type": "OpenAgentEngine",
          "Settings": {
            "AgentListPath": "/api/v1/agent/agents",
            "ChatPath": "/api/v1/agent/chat"
          }
        }
      ]
    }
  }
}
