{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Authentication": {
    "Mode": "Basic",
    "AllowTenantHeader": true,
    "AllowDevelopmentAnonymous": true,
    "DevelopmentUserId": "development-user",
    "DevelopmentTenantId": "development",
    "ProviderToken": {
      "Issuer": "openagent-router",
      "Audience": "openagent-engine-provider",
      "SigningKey": "openagent-development-provider-token-key-2026"
    }
  },
  "RouterSettings": {
    "Routing": {
      "EngineEndpoint": "http://localhost:5208",
      "WorkflowEndpoint": "http://localhost:5003"
    }
  }
}
