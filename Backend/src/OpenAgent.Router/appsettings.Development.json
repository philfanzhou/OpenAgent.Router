{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Authentication": {
    "Mode": "Basic",
    "AllowTenantHeader": true,
    "AllowDevelopmentAnonymous": true,
    "DevelopmentUserId": "development-user",
    "DevelopmentTenantId": "development"
  },
  "RouterSettings": {
    "Routing": {
      "EngineEndpoint": "http://localhost:5208",
      "WorkflowEndpoint": "http://localhost:5003"
    }
  }
}
