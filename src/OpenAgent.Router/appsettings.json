{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Extensions.Diagnostics.HealthChecks": "Warning",
        "Grpc": "Warning",
        "System.Net.Http": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Yarp.ReverseProxy": "Warning",
        "StackExchange.Redis": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Authentication": {
    "Mode": "JwtBearer",
    "EnableKeycloak": true,
    "Authority": "",
    "Audience": "",
    "ClientId": "",
    "Scopes": [
      "openid",
      "profile",
      "email",
      "organization"
    ],
    "RequireHttpsMetadata": true,
    "ClockSkewSeconds": 60,
    "AllowDevelopmentAnonymous": false,
    "DevelopmentUserId": "development-user",
    "DevelopmentTenantId": "development"
  },
  "RouterSettings": {
    "Caching": {
      "MaxRequestBodyBytes": 1048576,
      "MaxResponseBodyBytes": 4194304,
      "IdempotencyTtlSeconds": 86400,
      "IdempotencyPendingTtlSeconds": 120,
      "QueryTtlSeconds": 300
    },
    "RateLimiting": {
      "RequestsPerSecond": 100,
      "BurstCapacity": 200,
      "FailureMode": "Local"
    },
    "ServiceDiscovery": {
      "RefreshIntervalSeconds": 5,
      "HeartbeatStaleAfterSeconds": 60,
      "RedisFailureMode": "StaticOnly",
      "SnapshotMaxAgeSeconds": 15,
      "FailureThreshold": 1,
      "FailureQuarantineSeconds": 30,
      "ReadinessPath": "/ready",
      "ReadinessTimeoutMs": 2000
    },
    "IntentRecognition": {
      "Enabled": true,
      "FallbackAgentId": "default",
      "MinimumConfidence": 0.5,
      "TimeoutMs": 5000,
      "CatalogTimeoutMs": 3000
    },
    "AgentProviders": {
      "DefaultProviderId": "self-engine",
      "Providers": [
        {
          "Id": "self-engine",
          "Type": "OpenAgentEngine",
          "Settings": {}
        }
      ]
    },
    "DecisionModel": {
      "Endpoint": "",
      "ApiKey": "",
      "ApiKeyFile": "",
      "MaxPromptCharacters": 16000,
      "MaxInputCharacters": 7500,
      "MaxCandidates": 62,
      "MaxDescriptionCharacters": 2000,
      "MaxResponseBytes": 16384
    },
    "RoutingQuality": {
      "Enabled": true,
      "SampleRetentionDays": 30,
      "MaxSamplesPerTenant": 1000,
      "MaxMessageCharacters": 4000,
      "IncludeMessageContent": false
    },
    "Conversations": {
      "RetentionDays": 30,
      "StorageTimeoutMs": 2000
    }
  }
}
